# --- Postgres (one cluster, one schema per service) ---
# Local Postgres:   postgresql+asyncpg://<user>:<password>@localhost:5432/recoup
# compose postgres from the host:  postgresql+asyncpg://recoup:recoup@localhost:5433/recoup
DATABASE_URL=postgresql+asyncpg://recoup:recoup@localhost:5432/recoup

# --- Messaging (leave empty to log events instead of publishing) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- Auth (dev only; Keycloak/OIDC comes later) ---
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=recoup-iam
ACCESS_TOKEN_TTL_SECONDS=28800

# --- Service URLs (as seen from the host) ---
IAM_URL=http://localhost:8001
MOCK_ERP_URL=http://localhost:8002
CASE_URL=http://localhost:8003
POLICY_URL=http://localhost:8004
COMM_URL=http://localhost:8005
TOOL_GATEWAY_URL=http://localhost:8006
ORCHESTRATOR_URL=http://localhost:8007
REALTIME_URL=http://localhost:8008
TEMPORAL_ADDRESS=localhost:7233

# --- LLM (provider-agnostic; ids follow LangChain's init_chat_model) ---
# google_genai (Gemini) | openai (also vLLM/Ollama/OpenRouter via LLM_BASE_URL) | anthropic | azure_openai | groq | ...
# heuristic = deterministic rule-based stand-in: no key needed, used by CI and the default compose demo.
LLM_PROVIDER=google_genai
LLM_API_KEY=            # your Gemini API key (Google AI Studio); leave empty to fall back to heuristic in compose
LLM_MODEL_FAST=gemini-2.5-flash
LLM_MODEL_STRONG=gemini-2.5-pro
LLM_BASE_URL=           # only for OpenAI-compatible servers, e.g. http://localhost:11434/v1 for Ollama
LLM_FALLBACK_PROVIDER=heuristic   # used after repeated provider failures (or empty to disable)
AUTOSTART_ON_CASE_CREATED=true
MAILPIT_API_URL=http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
INBOUND_MAILBOX=ar@acme-demo.com
GATEWAY_URL=http://localhost:8000

# --- Observability (empty = tracing disabled) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# --- Case ingestion ---
INGEST_INTERVAL_SECONDS=60
INGEST_OVERDUE_DAYS=7
DEFAULT_TENANT_SLUG=acme
